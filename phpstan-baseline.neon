parameters:
	ignoreErrors:
		-
			message: '#^Strict comparison using \=\=\= between 20000000\|bool\|string and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: custom/plugin/Cod/Config/cod.php

		-
			message: '#^Strict comparison using \=\=\= between 500000\|bool\|string and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: custom/plugin/ShippingFlatRate/Config/shipping-flat-rate.php

		-
			message: '#^Call to an undefined method Illuminate\\Contracts\\Cache\\Repository\:\:lock\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: custom/plugin/ZaloZns/Infrastructure/ZnsClient.php

		-
			message: '#^Result of \|\| is always true\.$#'
			identifier: booleanOr.alwaysTrue
			count: 1
			path: modules/Cart/Application/CartService.php

		-
			message: '#^Strict comparison using \=\=\= between null and null will always evaluate to true\.$#'
			identifier: identical.alwaysTrue
			count: 1
			path: modules/Cart/Application/CartService.php

		-
			message: '#^Parameter \#1 \$array \(list\<array\{code\: string, translations\: array\<string, array\{label\: string\}\>\}\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: modules/Catalog/Application/Taxonomy/TaxonomyService.php

		-
			message: '#^Method Modules\\Catalog\\Persistence\\Models\\ProductCollection\:\:translationForeignKey\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: modules/Catalog/Persistence/Models/ProductCollection.php

		-
			message: '#^Using nullsafe property access "\?\-\>fee" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: modules/Checkout/Application/TotalsPipeline.php

		-
			message: '#^Using nullsafe property access "\?\-\>fee" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: modules/Checkout/Contracts/Data/Totals.php

		-
			message: '#^Access to an undefined property Pest\\Mixins\\Expectation\<mixed\>\:\:\$each\.$#'
			identifier: property.notFound
			count: 1
			path: modules/Checkout/Testing/CheckoutValidatorContract.php

		-
			message: '#^Using nullsafe property access "\?\-\>last_error" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: modules/Extension/Console/PluginListCommand.php

		-
			message: '#^Match expression does not handle remaining value\: string$#'
			identifier: match.unhandled
			count: 1
			path: modules/Extension/Contracts/Data/FieldDefinition.php

		-
			message: '#^Strict comparison using \!\=\= between array\{\} and array\{\} will always evaluate to false\.$#'
			identifier: notIdentical.alwaysFalse
			count: 1
			path: modules/Fulfillment/Domain/FulfillmentProgress.php

		-
			message: '#^Method Modules\\Integration\\Application\\ConnectorRegistry\:\:connectors\(\) invoked with 1 parameter, 0 required\.$#'
			identifier: arguments.count
			count: 1
			path: modules/Integration/Application/HealthQueries.php

		-
			message: '#^Instanceof between Modules\\Inventory\\Contracts\\Data\\BackorderAllowance and Modules\\Inventory\\Contracts\\Data\\BackorderAllowance will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: modules/Inventory/Application/BackorderService.php

		-
			message: '#^Match expression does not handle remaining value\: string$#'
			identifier: match.unhandled
			count: 1
			path: modules/Inventory/Http/Controllers/Admin/StockController.php

		-
			message: '#^Method Modules\\Inventory\\Contracts\\InventoryStrategy\:\:adjust\(\) invoked with 2 parameters, 1 required\.$#'
			identifier: arguments.count
			count: 2
			path: modules/Inventory/Testing/InventoryStrategyContract.php

		-
			message: '#^Call to function is_array\(\) with list\<Modules\\Ordering\\Contracts\\Data\\RiskSignal\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: modules/Ordering/Application/OrderRiskService.php

		-
			message: '#^Instanceof between Modules\\Ordering\\Contracts\\Data\\RiskSignal and Modules\\Ordering\\Contracts\\Data\\RiskSignal will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: modules/Ordering/Application/OrderRiskService.php

		-
			message: '#^Access to an undefined property Pest\\Mixins\\Expectation\<mixed\>\:\:\$each\.$#'
			identifier: property.notFound
			count: 1
			path: modules/Promotion/Testing/PromotionActionContract.php

		-
			message: '#^Access to an undefined property Pest\\Mixins\\Expectation\<mixed\>\:\:\$each\.$#'
			identifier: property.notFound
			count: 1
			path: modules/Promotion/Testing/PromotionRuleContract.php

		-
			message: '#^Call to function is_array\(\) with array\<string, mixed\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: modules/Storefront/Application/Enrichment.php

		-
			message: '#^Using nullsafe property access "\?\-\>default" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: modules/Tenancy/Application/DatabaseSettings.php
