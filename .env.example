APP_NAME=VaniShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vanishop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# VaniShop
VANI_PLUGINS_SAFE_MODE=false

# Plugin vani.vietqr (cổng QR động) — cấu hình theo pháp nhân trong code, phần định danh ở đây.
VIETQR_BANK_ID=970436
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_SECRET=
VIETQR_TTL=900

# Plugin vani.vnpay (Admin → Cấu hình ghi đè). IPN: /api/payments/vnpay/callback
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_SANDBOX=true
VNPAY_TTL=900
VNPAY_RETURN_URL=

# Plugin vani.ghn (Giao Hàng Nhanh)
GHN_CLIENT_ID=
GHN_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_SECRET=
GHN_FEE_STANDARD=30000
GHN_FEE_EXPRESS=55000

# Admin (ADR-020): production đặt đường dẫn khó đoán; IP/CIDR phân tách bằng dấu phẩy
VANI_ADMIN_PATH=admin
VANI_ADMIN_IP_ALLOWLIST=
VANI_ADMIN_IDLE_MINUTES=30

# --- Vận hành (ADR-032) ---
# Ảnh catalog: public (dev) | s3 (S3-compatible tại VN: đặt AWS_ENDPOINT, AWS_USE_PATH_STYLE_ENDPOINT=true nếu cần)
VANI_MEDIA_DISK=public
# Queue: database (dev) | redis (production, chạy `php artisan horizon`, cần ext phpredis)
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=phpredis
# Backup: local | s3_backup (bucket riêng)
VANI_BACKUP_DISKS=local
VANI_BACKUP_S3_BUCKET=
# Pulse (dashboard hiệu năng tự host, dưới /{VANI_ADMIN_PATH}/system/pulse)
PULSE_ENABLED=true
