includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - modules
        - custom/plugin
    excludePaths:
        - modules/*/Tests/*
        - custom/plugin/*/Tests/*
        - modules/*/Persistence/Database/migrations/*
        - custom/plugin/*/Database/migrations/*
    tmpDir: storage/framework/phpstan
    ignoreErrors:
        # Config của plugin (Config/*.php, nạp bằng mergeConfigFrom) là file cấu hình thật: env() được đánh giá khi
        # dựng config cache như config/ — Larastan chỉ biết thư mục config/.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            paths:
                - custom/plugin/*/Config/*
        # View storefront `theme::…` thuộc namespace đăng ký lúc chạy theo theme đang bật (UseActiveTheme) — Larastan
        # không suy ra được view-string. Chỉ áp cho controller web của storefront.
        -
            message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
            identifier: argument.type
            paths:
                - modules/Storefront/Http/Controllers/Web/*
