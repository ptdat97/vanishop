<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory>modules/*/Tests</directory>
        </testsuite>
        <testsuite name="Plugins">
            <directory>custom/plugin/*/Tests</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
        <testsuite name="Mysql">
            <directory>tests/Mysql</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
        <testsuite name="Performance">
            <directory>tests/Performance</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>concurrency</group>
            <group>mysql</group>
            <group>browser</group>
            <group>performance</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
            <directory>modules</directory>
            <directory>custom/plugin</directory>
        </include>
        <exclude>
            <directory>modules/*/Tests</directory>
            <directory>custom/plugin/*/Tests</directory>
        </exclude>
    </source>
    <php>
        <!-- Test arch() của Pest phân tích cú pháp mọi file và giữ cache tĩnh (~900 MB cho cả repo) — cộng phần feature
             (~250 MB) vượt 1 GB mặc định. Không phải rò bộ nhớ của ứng dụng (đo 2026-11-26, reference-parity §6b L52). -->
        <ini name="memory_limit" value="2G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="CACHE_DURABLE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="VANI_PLUGINS_CACHE" value="storage/framework/testing/vanishop-plugins.php"/>
        <env name="VANI_HOOKS_STRICT" value="true"/>
        <!-- Cửa hàng chạy một ngôn ngữ; test giữ hai ngôn ngữ để không mất cơ chế đa ngôn ngữ. -->
        <env name="VANI_LOCALES" value="vi,en"/>
        <env name="VANI_HOOKS_TRACE" value="false"/>
        <!-- Cache trang (ADR-051) tắt mặc định trong test; test riêng bật `app`/`cdn`. -->
        <env name="VANI_PAGE_CACHE" value="off"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
