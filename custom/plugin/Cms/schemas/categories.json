{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GET /categories",
    "type": "object",
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "slug",
                    "name",
                    "url"
                ],
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "url": {
                        "type": "string"
                    },
                    "meta_title": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "meta_description": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            }
        }
    }
}
