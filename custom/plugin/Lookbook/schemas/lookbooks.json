{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GET /lookbooks",
    "type": "object",
    "required": [
        "data",
        "meta"
    ],
    "properties": {
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "slug",
                    "name",
                    "cover_url",
                    "url",
                    "images_count"
                ],
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "cover_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "url": {
                        "type": "string"
                    },
                    "images_count": {
                        "type": "integer"
                    }
                }
            }
        },
        "meta": {
            "type": "object",
            "required": [
                "page",
                "per_page",
                "total"
            ],
            "properties": {
                "page": {
                    "type": "integer"
                },
                "per_page": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        }
    }
}
