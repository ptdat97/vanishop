{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vanishop.dev/schemas/storefront/order-placed.v1.json",
    "type": "object",
    "required": [
        "id",
        "number",
        "order_status",
        "payment_status",
        "total",
        "item_count",
        "access_token"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "number": {
            "type": "string"
        },
        "order_status": {
            "type": "string"
        },
        "payment_status": {
            "type": "string"
        },
        "total": {
            "type": "object",
            "required": [
                "amount",
                "currency"
            ],
            "properties": {
                "amount": {
                    "type": "integer"
                },
                "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                }
            }
        },
        "item_count": {
            "type": "integer"
        },
        "access_token": {
            "type": "string",
            "description": "Token xem/huỷ đơn không cần tài khoản (header `X-Vani-Order-Token`). Chỉ trả ở phản hồi đặt hàng."
        },
        "payment": {
            "type": [
                "object",
                "null"
            ],
            "required": [
                "id",
                "method",
                "status",
                "amount",
                "action",
                "retryable",
                "order"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "method": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "amount": {
                    "type": "object",
                    "required": [
                        "amount",
                        "currency"
                    ],
                    "properties": {
                        "amount": {
                            "type": "integer"
                        },
                        "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$"
                        }
                    }
                },
                "expires_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ISO-8601 (hiện theo UTC, xem backlog L29)."
                },
                "action": {
                    "type": "object",
                    "required": [
                        "type"
                    ],
                    "properties": {
                        "type": {
                            "type": "string"
                        },
                        "url": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "qr": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "instructions": {
                            "type": [
                                "string",
                                "object",
                                "array",
                                "null"
                            ]
                        }
                    }
                },
                "error": {
                    "type": [
                        "string",
                        "object",
                        "null"
                    ]
                },
                "retryable": {
                    "type": "boolean"
                },
                "order": {
                    "type": "object",
                    "required": [
                        "id",
                        "number"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "number": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "title": "Đơn vừa đặt"
}
