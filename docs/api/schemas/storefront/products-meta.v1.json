{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vanishop.dev/schemas/storefront/products-meta.v1.json",
    "type": "object",
    "required": [
        "total",
        "page",
        "per_page",
        "facets",
        "filters"
    ],
    "properties": {
        "total": {
            "type": "integer"
        },
        "page": {
            "type": "integer"
        },
        "per_page": {
            "type": "integer"
        },
        "facets": {
            "type": [
                "object",
                "null"
            ],
            "description": "null khi gọi `?ids=`.",
            "properties": {
                "attributes": {
                    "type": "array"
                },
                "brands": {
                    "type": "array"
                },
                "options": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "code",
                            "name",
                            "display_type",
                            "values"
                        ],
                        "properties": {
                            "code": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "display_type": {
                                "type": "string",
                                "enum": [
                                    "swatch",
                                    "button",
                                    "dropdown"
                                ]
                            },
                            "values": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "value",
                                        "label",
                                        "count"
                                    ],
                                    "properties": {
                                        "value": {
                                            "type": "string"
                                        },
                                        "label": {
                                            "type": "string"
                                        },
                                        "count": {
                                            "type": "integer"
                                        },
                                        "swatch": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "description": "Facet theo loại tuỳ chọn lọc được (ADR-045). Loại kiểu ô màu: `value` là nhóm màu, kèm `swatch`; loại khác: `value` là mã giá trị. Lọc bằng `opt[<code>]=<value>,…`."
                },
                "price": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "required": [
                        "min",
                        "max"
                    ],
                    "properties": {
                        "min": {
                            "type": "integer"
                        },
                        "max": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "filters": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "key",
                    "param",
                    "label",
                    "display",
                    "options"
                ],
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "param": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "display": {
                        "type": "string"
                    },
                    "options": {
                        "type": "array"
                    }
                }
            }
        }
    },
    "title": "meta của danh sách sản phẩm"
}
