{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vanishop.dev/schemas/storefront/products-meta.v1.json",
    "type": "object",
    "required": [
        "total",
        "page",
        "per_page",
        "facets",
        "filters"
    ],
    "properties": {
        "total": {
            "type": "integer"
        },
        "page": {
            "type": "integer"
        },
        "per_page": {
            "type": "integer"
        },
        "facets": {
            "type": [
                "object",
                "null"
            ],
            "description": "null khi gọi `?ids=`.",
            "properties": {
                "color_families": {
                    "type": [
                        "object",
                        "array"
                    ],
                    "description": "Object theo khoá; khi rỗng là `[]` (giới hạn hiện tại của JSON từ PHP, xem backlog L30)."
                },
                "attributes": {
                    "type": "array"
                },
                "brands": {
                    "type": "array"
                },
                "sizes": {
                    "type": "array"
                },
                "price": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "required": [
                        "min",
                        "max"
                    ],
                    "properties": {
                        "min": {
                            "type": "integer"
                        },
                        "max": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "filters": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "key",
                    "param",
                    "label",
                    "display",
                    "options"
                ],
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "param": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "display": {
                        "type": "string"
                    },
                    "options": {
                        "type": "array"
                    }
                }
            }
        }
    },
    "title": "meta của danh sách sản phẩm"
}
