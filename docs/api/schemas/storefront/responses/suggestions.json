{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GET /search/suggestions",
    "type": "object",
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "required": [
                "products",
                "categories",
                "brands",
                "search_url"
            ],
            "properties": {
                "products": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "slug",
                            "url"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "slug": {
                                "type": "string"
                            },
                            "name": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "image_url": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "url": {
                                "type": "string"
                            }
                        }
                    }
                },
                "categories": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "slug",
                            "url"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "slug": {
                                "type": "string"
                            },
                            "name": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "url": {
                                "type": "string"
                            }
                        }
                    }
                },
                "brands": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "slug",
                            "url"
                        ],
                        "properties": {
                            "slug": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "logo_url": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "url": {
                                "type": "string"
                            }
                        }
                    }
                },
                "search_url": {
                    "type": "string"
                }
            }
        }
    },
    "$id": "https://vanishop.dev/schemas/storefront/responses/suggestions.json"
}
