{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "POST /auth/register",
    "type": "object",
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "required": [
                "status",
                "email",
                "phone",
                "expires_in",
                "channel"
            ],
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "verify_email",
                        "verify_otp"
                    ],
                    "description": "verify_email: đã gửi link (POST /auth/register/verify); verify_otp: đã gửi mã tới SĐT (POST /auth/register/verify-otp)"
                },
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "phone": {
                    "type": "string",
                    "description": "SĐT đã chuẩn hoá E.164"
                },
                "expires_in": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "channel": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Kênh gửi mã OTP (sms, zns…); null khi gửi link email"
                }
            }
        }
    },
    "$id": "https://vanishop.dev/schemas/storefront/responses/registration-pending.json"
}
