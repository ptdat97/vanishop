{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vanishop.dev/schemas/storefront/responses/page-layout.json",
    "title": "GET /pages/layouts/{surface}",
    "type": "object",
    "required": ["data", "meta"],
    "additionalProperties": false,
    "properties": {
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["key", "blocks"],
                "additionalProperties": false,
                "properties": {
                    "key": {"type": "string"},
                    "blocks": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["type", "data"],
                            "additionalProperties": false,
                            "properties": {
                                "type": {"type": "string"},
                                "data": {"type": "object"}
                            }
                        }
                    }
                }
            }
        },
        "meta": {
            "type": "object",
            "required": ["surface", "configured"],
            "additionalProperties": false,
            "properties": {
                "surface": {"type": "string", "enum": ["listing", "product", "brands", "cart"]},
                "configured": {"type": "boolean"}
            }
        }
    }
}
