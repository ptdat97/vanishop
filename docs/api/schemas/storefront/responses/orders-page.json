{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GET /me/orders",
    "type": "object",
    "required": [
        "data",
        "meta"
    ],
    "properties": {
        "data": {
            "type": "array",
            "items": {
                "$ref": "../order.v1.json"
            }
        },
        "meta": {
            "type": "object",
            "required": [
                "page",
                "per_page",
                "total"
            ],
            "properties": {
                "page": {
                    "type": "integer"
                },
                "per_page": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        }
    },
    "$id": "https://vanishop.dev/schemas/storefront/responses/orders-page.json"
}
