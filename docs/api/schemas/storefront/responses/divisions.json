{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GET /address/provinces, …/wards",
    "type": "object",
    "required": [
        "data",
        "meta"
    ],
    "properties": {
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "code",
                    "name"
                ],
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                }
            }
        },
        "meta": {
            "type": "object",
            "required": [
                "directory"
            ],
            "properties": {
                "directory": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        }
    },
    "$id": "https://vanishop.dev/schemas/storefront/responses/divisions.json"
}
