{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vanishop.dev/schemas/storefront/responses/collection.json",
    "title": "GET /collections/{slug}",
    "type": "object",
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "required": [
                "id",
                "slug",
                "slugs",
                "locales",
                "name",
                "description",
                "meta_title",
                "meta_description",
                "image_url",
                "image_srcset"
            ],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "slug": {
                    "type": "string"
                },
                "slugs": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "locales": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "meta_title": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "meta_description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "image_url": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Ảnh bìa (bản 1600px)."
                },
                "image_srcset": {
                    "type": "string"
                }
            }
        }
    },
    "description": "Thông tin trang bộ sưu tập. Nội dung Builder của trang (chung và riêng từng bộ sưu tập) lấy qua GET /pages/layouts/listing?type=collection&slug=."
}
