{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "POST /auth/email/verify",
    "type": "object",
    "required": [
        "data"
    ],
    "properties": {
        "data": {
            "type": "object",
            "required": [
                "email",
                "email_verified"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "email_verified": {
                    "type": "boolean"
                }
            }
        }
    },
    "$id": "https://vanishop.dev/schemas/storefront/responses/email-verified.json"
}
