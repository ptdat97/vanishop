{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "PUT /carts/{id}/vouchers",
    "type": "object",
    "required": [
        "data",
        "meta"
    ],
    "properties": {
        "data": {
            "$ref": "../cart.v1.json"
        },
        "meta": {
            "type": "object",
            "required": [
                "rejected_vouchers"
            ],
            "properties": {
                "rejected_vouchers": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "code",
                            "reason"
                        ],
                        "properties": {
                            "code": {
                                "type": "string"
                            },
                            "reason": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "$id": "https://vanishop.dev/schemas/storefront/responses/cart-vouchers.json"
}
