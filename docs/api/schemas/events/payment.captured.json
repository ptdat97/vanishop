{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vanishop.dev/schemas/events/payment.captured.json",
    "title": "data của event payment.captured (v1)",
    "type": "object",
    "additionalProperties": false,
    "required": ["order_number", "payment_id", "gateway", "amount", "currency"],
    "properties": {
        "order_number": { "type": "string" },
        "payment_id": { "type": "integer" },
        "gateway": { "type": "string" },
        "amount": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
    }
}
