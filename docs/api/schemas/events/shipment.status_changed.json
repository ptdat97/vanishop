{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vanishop.dev/schemas/events/shipment.status_changed.json",
    "title": "data của event shipment.status_changed (v1)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "order_number",
        "shipment_id",
        "carrier",
        "tracking_number",
        "from",
        "to"
    ],
    "properties": {
        "order_number": {
            "type": "string"
        },
        "shipment_id": {
            "type": "string",
            "pattern": "^[0-9A-Z]{26}$",
            "description": "Định danh công khai (ULID)."
        },
        "from": {
            "type": "string",
            "enum": [
                "pending_booking",
                "booking_failed",
                "created",
                "picked_up",
                "in_transit",
                "out_for_delivery",
                "failed_attempt",
                "delivered",
                "returning",
                "returned",
                "cancelled"
            ]
        },
        "to": {
            "type": "string",
            "enum": [
                "pending_booking",
                "booking_failed",
                "created",
                "picked_up",
                "in_transit",
                "out_for_delivery",
                "failed_attempt",
                "delivered",
                "returning",
                "returned",
                "cancelled"
            ]
        },
        "carrier": {
            "type": [
                "string",
                "null"
            ]
        },
        "tracking_number": {
            "type": [
                "string",
                "null"
            ]
        },
        "reconciled": {
            "type": "boolean",
            "const": true,
            "description": "Có khi event được bù bởi đối soát (vani:integration:reconcile-orders)."
        }
    }
}
