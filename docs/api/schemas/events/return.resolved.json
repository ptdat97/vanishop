{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vanishop.dev/schemas/events/return.resolved.json",
    "title": "data của event return.resolved (v1)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "order_number",
        "return_id",
        "refunded_amount",
        "currency",
        "return_number"
    ],
    "properties": {
        "order_number": {
            "type": "string"
        },
        "return_id": {
            "type": "string",
            "pattern": "^[0-9A-Z]{26}$",
            "description": "Định danh công khai (ULID)."
        },
        "refunded_amount": {
            "type": "integer",
            "minimum": 0
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "return_number": {
            "type": [
                "string",
                "null"
            ]
        }
    }
}
