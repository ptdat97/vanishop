{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vanishop.dev/schemas/events/payment.refunded.json",
    "title": "data của event payment.refunded (v1)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "order_number",
        "refund_id",
        "payment_id",
        "amount",
        "currency"
    ],
    "properties": {
        "order_number": {
            "type": "string"
        },
        "refund_id": {
            "type": "string",
            "pattern": "^[0-9A-Z]{26}$",
            "description": "Định danh công khai (ULID)."
        },
        "payment_id": {
            "type": "string",
            "pattern": "^[0-9A-Z]{26}$",
            "description": "Định danh công khai (ULID)."
        },
        "amount": {
            "type": "integer",
            "minimum": 0
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "reconciled": {
            "type": "boolean",
            "const": true,
            "description": "Có khi event được bù bởi đối soát (vani:integration:reconcile-orders)."
        }
    }
}
